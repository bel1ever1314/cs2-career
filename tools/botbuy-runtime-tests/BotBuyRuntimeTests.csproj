<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="FakeCounterStrikeSharp.cs" />
    <Compile Include="BotBuyTestHost.cs" />
    <Compile Include="../../vendor/BotBuy/BotBuy.FullBuy.cs" Link="BotBuy.FullBuy.cs" />
    <Compile Include="../../vendor/BotBuy/CareerWeaponPolicy.cs" Link="CareerWeaponPolicy.cs" />
    <Compile Include="../../vendor/BotBuy/TacticalBuyPlan.cs" Link="TacticalBuyPlan.cs" />
  </ItemGroup>
  <!-- Compile the actual private production methods, not a copied purchase algorithm.
       Other plugin/event code requires a live game; only that surrounding API is faked. -->
  <UsingTask TaskName="ExtractBotBuyRuntime" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceFile ParameterType="System.String" Required="true" />
      <TacticalFile ParameterType="System.String" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var source = File.ReadAllText(SourceFile);
        var tactical = File.ReadAllText(TacticalFile);
        var generated = "using CounterStrikeSharp.API;\nusing CounterStrikeSharp.API.Core;\nusing CounterStrikeSharp.API.Modules.Utils;\nusing CounterStrikeSharp.API.Modules.Cvars;\nusing CounterStrikeSharp.API.Modules.Timers;\nusing CareerTactics;\nnamespace BotBuyPatch;\npublic sealed partial class BotBuyPatch\n{\n";
        foreach (var name in new[] { "CanModify", "HasPrimaryWeapon", "Buy", "IsFirstRoundOfHalf", "AddRoundTimer", "NormalizePurchasedWeapons" })
        {
            var match = Regex.Match(source, @"(?m)^    private (?:bool|void) " + name + @"\([^\r\n]*\)[\s\S]*?^    }");
            if (!match.Success) throw new InvalidOperationException("Production method missing: " + name);
            generated += match.Value + "\n";
        }
        var purchase = Regex.Match(tactical, @"(?m)^    private void ApplyTacticalPurchase\([^\r\n]*\)[\s\S]*?^    }");
        if (!purchase.Success) throw new InvalidOperationException("Production tactical purchase method missing");
        generated += purchase.Value + "\n";
        var schedule = Regex.Match(source, @"(?m)^        if \(_careerActive\)\r?\n            foreach \(var delay in new\[\][\s\S]*?^                }\);");
        if (!schedule.Success) throw new InvalidOperationException("Production career purchase schedule missing");
        generated += "private void ScheduleCareerChecks()\n{\n" + schedule.Value + "\n}\n}\n";
        Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
        File.WriteAllText(OutputFile, generated);
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="ExtractRuntimeUnderTest" BeforeTargets="CoreCompile">
    <ExtractBotBuyRuntime SourceFile="$(MSBuildProjectDirectory)/../../vendor/BotBuy/BotBuy.cs"
                         TacticalFile="$(MSBuildProjectDirectory)/../../vendor/BotBuy/BotBuy.TacticalSlots.cs"
                         OutputFile="$(IntermediateOutputPath)BotBuy.ProductionMethods.g.cs" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BotBuy.ProductionMethods.g.cs" />
    </ItemGroup>
  </Target>
</Project>
