// Bot Improver templates only; no upstream player list.
// Source VPK SHA-256: b08bf74eb74f1a0c9e84fb12c4a92bdb972703d35303cc69f9258176f0a10176
Default
        Skill = 100
        Aggression = 100
        ReactionTime = 0
        AttackDelay = 0
        Teamwork = 100
        AimFocusInitial = 0                    // initial focus spread in degrees (from desired center)
        AimFocusDecay = 0                             // how much focus shrinks per second (.25 = 25% of size after 1 sec)
        AimFocusOffsetScale = 0              // controls accuracy when tracking to target (0 == perfect, should always be < 1)
        AimfocusInterval = 0                  // how often focus is adjusted (smaller intervals means better movement tracking)
        WeaponPreference = none
        Cost = 4
        Difficulty = NORMAL
        VoicePitch = 100
        Skin = 0
	    LookAngleMaxAccelNormal = 99999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999.9.9.9.9
	    LookAngleStiffnessNormal = 3000.0
	    LookAngleDampingNormal = 45.0
	    LookAngleMaxAccelAttacking = 99999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999.9.9.9.9
	    LookAngleStiffnessAttacking = 3000.0
	    LookAngleDampingAttacking = 39.95
End

