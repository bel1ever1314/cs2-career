<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CareerMatch</AssemblyName>
    <RootNamespace>CareerMatch</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.371" />
    <EmbeddedResource Include="../../cs2career/data/tactical_maps.json" LogicalName="CareerMatch.TacticalMaps" />
  </ItemGroup>

  <ItemGroup><Compile Include="../BotBuy/TacticalBuyPlan.cs" Link="TacticalBuyPlan.cs" /></ItemGroup>
</Project>
